{
  "entities": {
    "Risk": {
      "title": "Risk Entity",
      "description": "Represents a compliance risk or finding.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "inherentImpact": { "type": "number" },
        "inherentLikelihood": { "type": "number" },
        "residualImpact": { "type": "number" },
        "residualLikelihood": { "type": "number" },
        "status": { "type": "string", "enum": ["Identified", "Mitigating", "Remediated", "Accepted"] },
        "ownerId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "ownerId", "status", "inherentImpact", "inherentLikelihood"]
    },
    "VendorAudit": {
      "title": "Vendor Audit",
      "description": "Records AI-assisted vendor contract audits.",
      "type": "object",
      "properties": {
        "vendorName": { "type": "string" },
        "contractSummary": { "type": "string" },
        "riskScore": { "type": "number" },
        "findings": { "type": "array", "items": { "type": "string" } },
        "status": { "type": "string" },
        "userId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["vendorName", "userId", "riskScore"]
    },
    "ControlAction": {
      "title": "Control Action Log",
      "description": "System event log for audit trails.",
      "type": "object",
      "properties": {
        "controlId": { "type": "string" },
        "action": { "type": "string" },
        "type": { "type": "string", "enum": ["AI_AUDIT", "RISK_ASSESSMENT", "POLICY_GENERATION", "LAB_EXECUTION", "SYSTEM"] },
        "status": { "type": "string", "enum": ["success", "failure"] },
        "details": { "type": "string" },
        "userId": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["action", "type", "userId", "timestamp"]
    },
    "Evidence": {
      "title": "Evidence Artifact",
      "description": "Immutable compliance evidence stored in the vault.",
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["POLICY", "AUDIT", "CONTROL_VERIFICATION", "CERTIFICATION"] },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "hash": { "type": "string" },
        "signature": { "type": "string" },
        "verifier": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "userId": { "type": "string" },
        "metadata": { "type": "object" }
      },
      "required": ["type", "title", "userId", "hash", "signature"]
    },
    "InventoryItem": {
      "title": "Inventory Item",
      "description": "Enterprise cloud topography service node.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "type": { "type": "string" },
        "provider": { "type": "string" },
        "status": { "type": "string", "enum": ["Healthy", "Degraded", "Vulnerable"] },
        "lastScanned": { "type": "string", "format": "date-time" },
        "vulnerabilities": { "type": "array", "items": { "type": "string" } },
        "userId": { "type": "string" }
      },
      "required": ["name", "type", "userId", "status"]
    }
  },
  "firestore": {
    "risks": {
      "schema": "Risk",
      "description": "Root collection for all compliance risks."
    },
    "vendorAudits": {
      "schema": "VendorAudit",
      "description": "Root collection for all TPRM audits."
    },
    "controlActions": {
      "schema": "ControlAction",
      "description": "System event and audit log stream."
    },
    "evidence": {
      "schema": "Evidence",
      "description": "The evidence vault for immutable artifacts."
    },
    "inventory": {
      "schema": "InventoryItem",
      "description": "Infrastructure service inventory nodes."
    }
  }
}
