{
  "entities": {
    "Risk": {
      "title": "Cybersecurity Risk",
      "description": "Represents a tracked risk, vulnerability, or compliance issue.",
      "type": "object",
      "properties": {
        "title": { "type": "string", "description": "The title of the risk" },
        "description": { "type": "string", "description": "Detailed description of the risk" },
        "impact": { "type": "string", "enum": ["Low", "Moderate", "High", "Critical"] },
        "owner": { "type": "string", "description": "Team or person responsible" },
        "status": { "type": "string", "enum": ["Open", "Pending", "Mitigated"] },
        "compliance": { "type": "string", "description": "Linked compliance framework (e.g., SOC2)" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "ownerId": { "type": "string", "description": "The UID of the user who logged the risk" }
      },
      "required": ["title", "impact", "status", "ownerId"]
    },
    "Evidence": {
      "title": "Compliance Evidence",
      "description": "Evidence collected for an audit or control.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "fileType": { "type": "string" },
        "fileUrl": { "type": "string" },
        "controlId": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "verified", "rejected", "expiring"] },
        "uploadedBy": { "type": "string", "description": "The UID of the user who uploaded the evidence" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "fileType", "uploadedBy", "status"]
    },
    "UserProfile": {
      "title": "User Profile",
      "description": "Stored user information.",
      "type": "object",
      "properties": {
        "displayName": { "type": "string" },
        "email": { "type": "string" },
        "photoURL": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "viewer", "editor"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["email", "role"]
    },
    "ControlAction": {
      "title": "Control Action",
      "description": "Recorded automation or manual action performed on a control.",
      "type": "object",
      "properties": {
        "action": { "type": "string" },
        "controlId": { "type": "string" },
        "details": { "type": "string" },
        "status": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["action", "status", "timestamp"]
    },
    "InventoryItem": {
      "title": "Inventory Item",
      "description": "Asset or resource in the organizational inventory.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "type": { "type": "string" },
        "owner": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "type"]
    }
  },
  "firestore": {
    "/risks/{riskId}": {
      "schema": "Risk",
      "description": "Collection of identified risks."
    },
    "/evidence/{evidenceId}": {
      "schema": "Evidence",
      "description": "Vault for storing compliance evidence."
    },
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profiles and permissions."
    },
    "/controlActions/{actionId}": {
      "schema": "ControlAction",
      "description": "History of actions taken on controls."
    },
    "/inventory/{itemId}": {
      "schema": "InventoryItem",
      "description": "Catalog of assets and resources."
    }
  }
}
