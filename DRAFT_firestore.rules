rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Role check: Look up user in private profile or check a flag
    // For this app, we'll assume admins are in a collection /admins/
    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // --- Validation Helpers ---

    function isValidRisk(data) {
      return data.keys().hasAll(['title', 'impact', 'status', 'ownerId', 'createdAt', 'updatedAt'])
        && data.title is string && data.title.size() <= 200
        && data.impact in ['Low', 'Moderate', 'High', 'Critical']
        && data.status in ['Open', 'Pending', 'Mitigated']
        && data.ownerId == request.auth.uid
        && data.createdAt == request.time
        && data.updatedAt == request.time;
    }

    function isValidEvidence(data) {
      return data.keys().hasAll(['title', 'fileType', 'uploadedBy', 'status', 'createdAt', 'updatedAt'])
        && data.title is string && data.title.size() <= 200
        && data.fileType is string
        && data.uploadedBy == request.auth.uid
        && data.status == 'pending'
        && data.createdAt == request.time
        && data.updatedAt == request.time;
    }

    function isValidUser(data) {
      return data.keys().hasAll(['email', 'role', 'createdAt'])
        && data.email is string && data.email.size() <= 256
        && data.role in ['admin', 'viewer', 'editor']
        && data.createdAt == request.time;
    }

    // --- Rules ---

    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId) && isValidUser(incoming()) && incoming().role == 'viewer'; // Default to viewer
      allow update: if (isOwner(userId) || isAdmin()) 
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL'])
        && incoming().email == existing().email
        && incoming().role == existing().role;
    }

    match /risks/{riskId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn(); // In a real app, might want to filter by org
      allow create: if isSignedIn() && isValidId(riskId) && isValidRisk(incoming());
      allow update: if (isSignedIn() && (
        (isOwner(existing().ownerId) && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'description', 'impact', 'status', 'updatedAt']) && incoming().updatedAt == request.time)
        || isAdmin()
      ));
      allow delete: if isAdmin();
    }

    match /evidence/{evidenceId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(evidenceId) && isValidEvidence(incoming());
      allow update: if isAdmin(); // Only admins/reviewers can verify evidence
      allow delete: if isAdmin();
    }

    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if false; // Managed via console or CLI
    }
  }
}
