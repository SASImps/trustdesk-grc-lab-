rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Phase 3: Primitive Definitions
    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Helper to validate string size
    function isLimitString(val, max) {
      return val is string && val.size() <= max;
    }

    // Validation Blueprints
    function isValidRisk(data) {
      return data.keys().hasAll(['title', 'description', 'ownerId', 'status', 'inherentImpact', 'inherentLikelihood', 'createdAt'])
        && data.keys().size() <= 10
        && isLimitString(data.title, 200)
        && isLimitString(data.description, 2000)
        && data.ownerId == request.auth.uid
        && data.status in ['Identified', 'Mitigating', 'Remediated', 'Accepted']
        && data.inherentImpact is int && data.inherentImpact >= 1 && data.inherentImpact <= 5
        && data.inherentLikelihood is int && data.inherentLikelihood >= 1 && data.inherentLikelihood <= 5;
    }

    function isValidVendorAudit(data) {
      return data.keys().hasAll(['vendorName', 'contractSummary', 'riskScore', 'findings', 'status', 'userId', 'createdAt'])
        && data.keys().size() <= 8
        && isLimitString(data.vendorName, 200)
        && data.riskScore is int
        && data.findings is list && data.findings.size() <= 50
        && data.userId == request.auth.uid;
    }

    function isValidControlAction(data) {
      return data.keys().hasAll(['action', 'type', 'userId', 'timestamp', 'status', 'details', 'controlId'])
        && data.keys().size() <= 7
        && data.userId == request.auth.uid
        && data.type in ['AI_AUDIT', 'RISK_ASSESSMENT', 'POLICY_GENERATION', 'LAB_EXECUTION', 'SYSTEM']
        && data.status in ['success', 'failure'];
    }

    function isValidEvidence(data) {
      return data.keys().hasAll(['type', 'title', 'description', 'hash', 'signature', 'verifier', 'timestamp', 'userId', 'metadata'])
        && data.keys().size() <= 10
        && data.userId == request.auth.uid
        && isLimitString(data.hash, 128)
        && isLimitString(data.signature, 256);
    }

    function isValidInventory(data) {
      return data.keys().hasAll(['name', 'type', 'provider', 'status', 'lastScanned', 'vulnerabilities', 'userId'])
        && data.keys().size() <= 7
        && data.userId == request.auth.uid
        && data.status in ['Healthy', 'Degraded', 'Vulnerable']
        && data.vulnerabilities is list && data.vulnerabilities.size() <= 20;
    }

    // Collection Rules

    match /risks/{riskId} {
      allow get: if isOwner(existing().ownerId) && isValidId(riskId);
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isSignedIn() && isValidRisk(incoming()) && isValidId(riskId);
      allow update: if isOwner(existing().ownerId) && isValidRisk(incoming()) && (
        // Action: Update Status or Remeditation
        incoming().diff(existing()).affectedKeys().hasOnly(['status', 'residualImpact', 'residualLikelihood', 'updatedAt'])
      ) && incoming().ownerId == existing().ownerId;
      allow delete: if isOwner(existing().ownerId);
    }

    match /vendorAudits/{auditId} {
      allow get: if isOwner(existing().userId) && isValidId(auditId);
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidVendorAudit(incoming()) && isValidId(auditId);
    }

    match /controlActions/{actionId} {
      allow get: if isOwner(existing().userId) && isValidId(actionId);
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidControlAction(incoming()) && isValidId(actionId);
    }

    match /evidence/{evidenceId} {
      allow get: if isOwner(existing().userId) && isValidId(evidenceId);
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidEvidence(incoming()) && isValidId(evidenceId);
    }

    match /inventory/{nodeId} {
      allow get: if isOwner(existing().userId) && isValidId(nodeId);
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidInventory(incoming()) && isValidId(nodeId);
      allow update: if isOwner(existing().userId) && isValidInventory(incoming()) && (
        incoming().diff(existing()).affectedKeys().hasOnly(['status', 'vulnerabilities', 'lastScanned'])
      ) && incoming().userId == existing().userId;
    }
  }
}
