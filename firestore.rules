rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // --- Validation Helpers ---

    function isValidRisk(data) {
      return data.keys().hasAll(['title', 'impact', 'status', 'ownerId', 'createdAt', 'updatedAt'])
        && data.title is string && data.title.size() <= 200
        && data.impact in ['Low', 'Moderate', 'High', 'Critical']
        && data.status in ['Open', 'Pending', 'Mitigated']
        && data.ownerId == request.auth.uid
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidEvidence(data) {
      return data.keys().hasAll(['title', 'fileType', 'uploadedBy', 'status', 'createdAt', 'updatedAt'])
        && data.title is string && data.title.size() <= 200
        && data.fileType is string
        && data.uploadedBy == request.auth.uid
        && data.status is string
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidUser(data) {
      return data.keys().hasAll(['email', 'role', 'createdAt'])
        && data.email is string && data.email.size() <= 256
        && data.role in ['admin', 'viewer', 'editor']
        && data.createdAt is timestamp;
    }

    function isValidControlAction(data) {
      return data.keys().hasAll(['action', 'status', 'timestamp'])
        && data.action is string && data.action.size() <= 300
        && data.status is string
        && data.timestamp is timestamp;
    }

    function isValidInventoryItem(data) {
      return data.keys().hasAll(['name', 'type'])
        && data.name is string && data.name.size() <= 200
        && data.type is string;
    }

    // --- Rules ---

    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId) && isValidUser(incoming()) 
        && incoming().role == 'viewer'
        && incoming().createdAt == request.time;
      allow update: if (isOwner(userId) || isAdmin()) 
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL'])
        && incoming().email == existing().email
        && incoming().role == existing().role;
    }

    match /risks/{riskId} {
      allow get: if isSignedIn() && (isOwner(existing().ownerId) || isAdmin());
      allow list: if isSignedIn() && (resource.data.ownerId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isValidId(riskId) && isValidRisk(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isSignedIn() && (
        (isOwner(existing().ownerId) && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'description', 'impact', 'status', 'updatedAt']) 
          && incoming().updatedAt == request.time
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt)
        || isAdmin()
      );
      allow delete: if isAdmin();
    }

    match /evidence/{evidenceId} {
      allow get: if isSignedIn() && (isOwner(existing().uploadedBy) || isAdmin());
      allow list: if isSignedIn() && (resource.data.uploadedBy == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isValidId(evidenceId) && isValidEvidence(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isAdmin(); 
      allow delete: if isAdmin();
    }

    match /controlActions/{actionId} {
      allow read: if isSignedIn();
      allow create: if isAdmin() && isValidControlAction(incoming());
      allow update, delete: if isAdmin();
    }

    match /inventory/{itemId} {
      allow read: if isSignedIn();
      allow create: if isAdmin() && isValidInventoryItem(incoming());
      allow update, delete: if isAdmin();
    }

    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if false; 
    }
  }
}
